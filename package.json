{
  "name": "marta-receipts",
  "version": "1.0.0",
  "description": "Transit Ledger ATL — MARTA GTFS-RT reliability dashboard (poller, TimescaleDB, Gemini)",
  "private": true,
  "type": "module",
  "scripts": {
    "poll": "tsx poller/index.ts",
    "poll:loop": "bash scripts/poll-loop.sh 30",
    "web": "tsx web/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "gtfs-realtime-bindings": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
